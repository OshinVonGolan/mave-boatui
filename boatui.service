[Unit]
Description=Mave Boat Monitor UI
After=network.target

[Service]
Type=simple
User=joshy
WorkingDirectory=/home/joshy/mave-boatui
ExecStart=/home/joshy/mave-boatui/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
