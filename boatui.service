[Unit]
Description=Mave Boat Monitor UI
After=network.target can.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mave-boatui
ExecStart=/home/pi/mave-boatui/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
